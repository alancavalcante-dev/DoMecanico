# Rastreamento de anúncios (Meta Pixel + Google). Copie para `.env.production`
# NA VPS (frontend/.env.production) e preencha com os seus IDs; depois rode o
# deploy (npm run build inlina estes valores no bundle). O arquivo .env.production
# é gitignored — sobrevive ao `git pull` e não vaza no repositório.
#
# São IDs PÚBLICOS (aparecem no navegador de qualquer forma) — não são segredos.
# Deixe em branco/ausente para manter o tracker desligado.

# Meta Pixel (Facebook/Instagram Ads) — só os dígitos, ex: 123456789012345
VITE_META_PIXEL_ID=

# Google Analytics 4 — ex: G-XXXXXXXXXX
VITE_GA_ID=

# Google Ads (conversões) — ex: AW-XXXXXXXXX
VITE_GOOGLE_ADS_ID=

# Rótulo da conversão de CADASTRO do Google Ads (a parte depois da "/" do
# "AW-XXXX/rótulo"). Opcional: se você importar o cadastro pelo GA4, não precisa.
VITE_GOOGLE_ADS_LABEL=

# Rótulo da conversão de ASSINATURA PAGA do Google Ads (outra ação de conversão,
# outro rótulo). É o evento que faz o anúncio otimizar por quem PAGA, não por
# quem só se cadastra. Opcional: Meta (Purchase) e GA4 (purchase) já funcionam
# sem ele — este só liga a conversão DIRETA do Google Ads.
VITE_GOOGLE_ADS_LABEL_ASSINATURA=
